# ==============================================================================
# Job Aggregation & Distribution System Configuration
# ==============================================================================

# Server & Node Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration (PostgreSQL / Supabase / Neon / Local Docker)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/job_automation_db?schema=public"

# DeepSeek AI Configuration (https://platform.deepseek.com)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# WhatsApp Automation Settings (Playwright)
WHATSAPP_SESSION_PATH="./data/whatsapp_session"
WHATSAPP_HEADLESS=true
WHATSAPP_MESSAGE_DELAY_MS=3500

# WhatsApp Group Names (Target group exact names or IDs on WhatsApp)
WHATSAPP_GROUP_TECH="Tech Jobs"
WHATSAPP_GROUP_INTERNSHIP="Internships"
WHATSAPP_GROUP_NON_TECH="Non-Tech Jobs"
WHATSAPP_GROUP_GOVT="Government Jobs"
WHATSAPP_GROUP_COHORT="Cohorts & Upskilling"
WHATSAPP_GROUP_REFERRAL="Referrals & Networking"
WHATSAPP_GROUP_COMMUNITY="Daily Highlights"

# Publishing Settings
MIN_SCORE_TO_PUBLISH=70
MAX_JOBS_PER_BATCH=5

# Scheduling Cron Expressions (IST - Asia/Kolkata, Supports multi-slot separated by |)
CRON_COLLECTION="*/15 * * * *"               # Every 15 minutes
CRON_GOVT="45 8 * * * | 15 20 * * *"         # 8:45 AM & 8:15 PM IST
CRON_TECH="45 9 * * * | 15 18 * * *"         # 9:45 AM & 6:15 PM IST
CRON_INTERNSHIP="15 10 * * * | 30 17 * * *"   # 10:15 AM & 5:30 PM IST
CRON_NON_TECH="0 11 * * * | 15 19 * * *"     # 11:00 AM & 7:15 PM IST
CRON_REFERRAL="45 13 * * *"                  # 1:45 PM IST
CRON_DIGEST="0 21 * * *"                     # 9:00 PM IST

# Safety / Simulation Mode
# Set to 'true' to simulate WhatsApp sending (logs to console/file without actual posting)
DRY_RUN=false
