{
  "name": "job-aggregation-distribution-system",
  "version": "1.0.0",
  "description": "Production-grade automated Job Aggregation and Distribution System with WhatsApp publishing",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "cli": "tsx src/cli/index.ts",
    "auth:whatsapp": "tsx src/cli/index.ts auth",
    "session:encrypt": "tsx scripts/encrypt_session.ts",
    "session:decrypt": "tsx scripts/decrypt_session.ts",
    "session:push": "tsx src/cli/index.ts session:push",
    "session:pull": "tsx src/cli/index.ts session:pull",
    "scrape": "tsx src/cli/index.ts scrape",
    "collect": "tsx src/cli/index.ts collect",
    "process": "tsx src/cli/index.ts process",
    "send:tech": "tsx src/cli/index.ts live --category TECH",
    "send:tech:5": "tsx src/cli/index.ts live --category TECH --limit 5",
    "send:tech:all": "tsx src/cli/index.ts live --category TECH --limit all",
    "send:internship": "tsx src/cli/index.ts live --category INTERNSHIP",
    "send:internship:5": "tsx src/cli/index.ts live --category INTERNSHIP --limit 5",
    "send:internship:all": "tsx src/cli/index.ts live --category INTERNSHIP --limit all",
    "send:nontech": "tsx src/cli/index.ts live --category NON_TECH",
    "send:nontech:5": "tsx src/cli/index.ts live --category NON_TECH --limit 5",
    "send:nontech:all": "tsx src/cli/index.ts live --category NON_TECH --limit all",
    "send:govt": "tsx src/cli/index.ts live --category GOVT",
    "send:govt:5": "tsx src/cli/index.ts live --category GOVT --limit 5",
    "send:govt:all": "tsx src/cli/index.ts live --category GOVT --limit all",
    "send:cohort": "tsx src/cli/index.ts live --category COHORT",
    "send:cohort:5": "tsx src/cli/index.ts live --category COHORT --limit 5",
    "send:cohort:all": "tsx src/cli/index.ts live --category COHORT --limit all",
    "send:referral": "tsx src/cli/index.ts live --category REFERRAL",
    "send:referral:5": "tsx src/cli/index.ts live --category REFERRAL --limit 5",
    "send:referral:all": "tsx src/cli/index.ts live --category REFERRAL --limit all",
    "send:community": "tsx src/cli/index.ts live --category COMMUNITY --limit 5",
    "publish:tech": "tsx src/cli/index.ts publish --category TECH",
    "publish:internship": "tsx src/cli/index.ts publish --category INTERNSHIP",
    "publish:nontech": "tsx src/cli/index.ts publish --category NON_TECH",
    "publish:govt": "tsx src/cli/index.ts publish --category GOVT",
    "publish:referral": "tsx src/cli/index.ts publish --category REFERRAL",
    "publish:digest": "tsx src/cli/index.ts publish --digest",
    "start:scheduler": "tsx src/cli/index.ts daemon",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test": "tsx test/index.test.ts"
  },
  "keywords": [
    "job-aggregator",
    "whatsapp-automation",
    "playwright",
    "deepseek",
    "prisma",
    "postgresql",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "openai": "^4.85.4",
    "playwright": "1.50.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
